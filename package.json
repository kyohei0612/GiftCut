{
  "name": "giftcut",
  "version": "0.1.35",
  "description": "切り抜き動画特化のテロップ編集アプリ",
  "author": "kyohei",
  "main": "./boot.js",
  "bundleFormat": 1,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "check": "node scripts/check-project.mjs",
    "index": "node scripts/gen-index.mjs",
    "passthrough": "node scripts/passthrough.mjs",
    "measure": "node scripts/measure.mjs",
    "audit": "node e2e/panel-audit.mjs",
    "verify": "npm run typecheck && npm run test",
    "check:dist": "node scripts/check-dist.mjs",
    "release:check": "npm run verify && npm run check:ffmpeg && npm run build && npm run check:dist && npm run dist && npm run check:packaged && npm run check:swap",
    "e2e": "node e2e/lint-checks.mjs && node e2e/run-parallel.mjs",
    "bench": "node e2e/bench.mjs --no-limits --no-export",
    "bench:limits": "node e2e/bench.mjs --no-export",
    "bench:export": "node e2e/bench.mjs --no-limits",
    "stutter": "node e2e/stutter.mjs",
    "soak": "node e2e/soak.mjs",
    "solo": "node e2e/solo-audit.mjs",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs",
    "fetch:whisper": "node scripts/fetch-whisper.mjs",
    "subcheck": "npx tsx e2e/subtitle-check.mjs",
    "subui": "npx tsx e2e/subtitle-ui.mjs",
    "dist": "npm run check:ffmpeg && npm run build && electron-builder --win --config electron-builder.yml",
    "dist:zip": "npm run check:ffmpeg && npm run build && electron-builder --win zip --config electron-builder.yml",
    "check:packaged": "node scripts/check-packaged.mjs",
    "release": "npm run verify && npm run check:ffmpeg && npm run build && node scripts/release.mjs",
    "publish:only": "electron-builder --win --config electron-builder.yml --publish always",
    "check:release": "node scripts/check-release.mjs",
    "frames": "vitest run --config vitest.frames.config.ts",
    "presets": "node e2e/telop-presets.mjs",
    "check:swap": "node scripts/check-swap.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
